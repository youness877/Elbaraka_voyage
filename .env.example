# ————————————————————————————————————————————————
# Base de données (Neon PostgreSQL)
# ————————————————————————————————————————————————
# Chaîne de connexion Postgres. En local, pointez vers une base Postgres
# de développement ; en production, utilisez l'URL "pooled" fournie par Neon.
DATABASE_URL=postgresql://neondb_owner:npg_KDdlNoY37Uys@ep-royal-mode-aeino296-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# ————————————————————————————————————————————————
# Sessions admin (tableau de bord /admin)
# ————————————————————————————————————————————————
# Secret utilisé pour signer les cookies de session admin (JWT HS256).
# OBLIGATOIRE en production — générez une valeur aléatoire et longue, par ex. :
#   openssl rand -base64 48
SESSION_SECRET="changez-moi-avec-une-valeur-aleatoire-et-longue"

# ————————————————————————————————————————————————
# Médiathèque (Cloudinary) — upload des images depuis l'admin
# ————————————————————————————————————————————————
# Créez un compte gratuit sur https://cloudinary.com puis récupérez ces 3
# valeurs dans le "Dashboard" de votre compte.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ————————————————————————————————————————————————
